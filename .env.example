# Path of the SQLite database file (default ./data/app.db)
DATABASE_PATH=
# Folder where uploaded receipt images are stored (default ./data/uploads)
UPLOADS_DIR=
# Required: long random string (at least 32 characters) used to sign login sessions
BETTER_AUTH_SECRET=
# Required: public address of the app, for example http://192.168.1.10:3100
APP_URL=
# Optional: Anthropic API key for AI features
ANTHROPIC_API_KEY=
# Optional: OpenAI API key for AI features
OPENAI_API_KEY=
# Optional: DeepSeek API key for AI features
DEEPSEEK_API_KEY=
# Optional: one-time token that lets the owner reset their password
OWNER_RESET_TOKEN=
# Leave empty at home. Set to 1 only on a server behind Caddy or another reverse proxy (see docs/deploy.md)
TRUST_PROXY=
